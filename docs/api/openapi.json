                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Kilometraje"
          },
          "danos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Danos",
            "default": []
          }
        },
        "type": "object",
        "title": "EntregaIn"
      },
      "ExtensionIn": {
        "properties": {
