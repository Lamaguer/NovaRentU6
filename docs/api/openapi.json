        "properties": {
          "cliente": {
            "type": "string",
            "title": "Cliente"
          },
          "sucursal_id": {
            "type": "string",
            "title": "Sucursal Id"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "inicio": {
            "type": "string",
            "format": "date",
            "title": "Inicio"
          },
          "fin": {
            "type": "string",
            "format": "date",
            "title": "Fin"
          }
