# Copiar a .env (NO subir .env). Sin secretos reales.
# Docker Compose usa estas variables; la DATABASE_URL se arma sola en docker-compose.yml.
APP_ENV=development
POSTGRES_USER=novarent
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=novarent
WEB_PORT=8000

# Solo para ejecutar la API fuera de Docker (uvicorn local). Sin ella usa SQLite en memoria.
# DATABASE_URL=postgresql+psycopg://novarent:cambiar@localhost:5432/novarent
PORT=8000
